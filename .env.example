# Copy to .env and edit. .env is gitignored; this file is the documented
# contract. Real environment variables override anything set here.
#
# NOTE: keep comments on their OWN line. VS Code's .env loader does not strip
# inline comments, so "KEY=value  # note" becomes the value "value  # note".

# ------------------------------------------------------------------- app
# local | docker | prod
ENVIRONMENT=local
LOG_LEVEL=INFO
RANDOM_SEED=42

# ------------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------------------------------------------- training
TEST_SIZE=0.2
# Expected anomaly rate. The Kaggle fraud rate is 0.00172.
CONTAMINATION=0.0017
N_ESTIMATORS=200

# ------------------------------------------------------------ thresholds
# Risk = the XGBoost model's predicted fraud probability.
# Chosen in notebooks/008_xgboost_thresholds.ipynb by minimising expected cost
# on out-of-fold probabilities under the assumptions below.
# risk >= REVIEW_THRESHOLD -> analyst review
REVIEW_THRESHOLD=0.24
# risk >= BLOCK_THRESHOLD  -> block automatically. "none" = never block.
# Blocking only pays when precision > 1 - REVIEW_COST / FALSE_BLOCK_COST (90%).
# At 0.95 the model's out-of-fold precision is about 98%.
BLOCK_THRESHOLD=0.95

# ------------------------------------------------------ cost assumptions
# Illustrative figures, not industry data. Change them and re-run notebook 008.
# $ of analyst time per reviewed transaction
REVIEW_COST=5
# $ per legitimate customer wrongly blocked
FALSE_BLOCK_COST=50
# $ added to the fraud amount when fraud gets through
CHARGEBACK_FEE=15
# analyst capacity: at most this share of transactions can be reviewed
MAX_REVIEW_RATE=0.02

# ------------------------------------------------------ storage (Phase 3)
# local: 127.0.0.1:5433, the Compose Postgres. Not "localhost": Windows tries
# IPv6 first, and Compose only listens on IPv4, which costs ~5s per connection.
# docker: postgres:5432 (set by docker-compose.yml, not read from here)
DATABASE_URL=postgresql+psycopg://fraud:fraud@127.0.0.1:5433/fraud
# Record every decision in Postgres. false = score without a database.
PERSIST_DECISIONS=true

# ---------------------------------------------------- streaming (Phase 4)
# local: 127.0.0.1:9092 (EXTERNAL listener)   |   docker: kafka:29092 (INTERNAL listener)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=transactions
KAFKA_DLQ_TOPIC=transactions.dlq
KAFKA_CONSUMER_GROUP=fraud-scorer
PRODUCER_RATE_PER_SEC=20
# messages per model call and database write in the consumer
CONSUMER_MAX_BATCH=500

# -------------------------------------------------------- redis (Phase 5)
# local: localhost:6379   |   docker: redis:6379
REDIS_URL=redis://localhost:6379/0
