# Copy to .env and edit. .env is gitignored; this file is the documented
# contract. Real environment variables override anything set here.
#
# NOTE: keep comments on their OWN line. VS Code's .env loader does not strip
# inline comments, so "KEY=value  # note" becomes the value "value  # note".

# ------------------------------------------------------------------- app
# local | docker | prod
ENVIRONMENT=local
LOG_LEVEL=INFO
RANDOM_SEED=42

# ------------------------------------------------------------------- api
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------------------------------------------- training
TEST_SIZE=0.2
# Expected anomaly rate. The Kaggle fraud rate is 0.00172.
CONTAMINATION=0.0017
N_ESTIMATORS=200

# ------------------------------------------------------------ thresholds
# score >= REVIEW_THRESHOLD -> route to manual review
REVIEW_THRESHOLD=0.50
# score >= FLAG_THRESHOLD   -> flag / block  (must be >= REVIEW_THRESHOLD)
FLAG_THRESHOLD=0.70

# ------------------------------------------------------ storage (Phase 3)
# local: localhost:5432   |   docker: postgres:5432
DATABASE_URL=postgresql+psycopg://fraud:fraud@localhost:5432/fraud

# ---------------------------------------------------- streaming (Phase 4)
# local: localhost:9092   |   docker: kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions
KAFKA_DLQ_TOPIC=transactions.dlq
KAFKA_CONSUMER_GROUP=fraud-scorer
PRODUCER_RATE_PER_SEC=20

# -------------------------------------------------------- redis (Phase 5)
# local: localhost:6379   |   docker: redis:6379
REDIS_URL=redis://localhost:6379/0
